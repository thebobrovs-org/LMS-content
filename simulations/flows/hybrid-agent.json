    },
    {
      "stepNumber": 3,
      "pillLabel": "3. ADK Step",
      "activeEdgeIds": ["e4", "e5"],
      "sequentialEdges": true,
      "packetLabel": "Agent Context",
      "durationMs": 1400,
      "narrationTitle": "Workflow Invokes Registered ADK Agent",
      "narrationBody": "The workflow passes pricing context to the Existing-agent step, which delegates reasoning to your ADK agent on Agent Runtime."
    },
    {
      "stepNumber": 4,
      "pillLabel": "4. Approval",
      "activeEdgeIds": ["e6"],
      "packetLabel": "Sign-off",
      "durationMs": 1000,
      "narrationTitle": "Human-in-the-Loop Approval",
      "narrationBody": "Before finalizing, the workflow pauses at Human approval so a person can review and sign off."
    },
    {
      "stepNumber": 5,
      "pillLabel": "5. Direct Path",
      "activeEdgeIds": ["e7", "e8"],
      "sequentialEdges": true,
      "packetLabel": "Direct Chat",
      "durationMs": 1400,
      "narrationTitle": "Alternative: Direct Access to Registered ADK Agent",
